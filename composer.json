{
  "name": "vdava/simplejack",
  "description": "Simple Jack Wordpress theme",
  "type": "wordpress-theme",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Victor Davalos"
    }
  ],
  "minimum-stability": "stable",
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "require-dev": {
    "wp-coding-standards/wpcs": "3.4.1"
  },
  "scripts": {
    "lint": "phpcs --extensions=php --standard=WordPress --ignore=stubs/*,vendor/*,node_modules/* .",
    "fix": "phpcbf --extensions=php --standard=WordPress --ignore=stubs/*,vendor/*,node_modules/* ."
  }
}
